<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="LTC2.Desktopclients.AvaloniaClient.App"
             RequestedThemeVariant="Light"
             Name="Long Term NL Postcode Challenge">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Long Term NL Postcode Challenge" Click="ShowAboutHandler" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml"/>
    </Application.Styles>
</Application>
