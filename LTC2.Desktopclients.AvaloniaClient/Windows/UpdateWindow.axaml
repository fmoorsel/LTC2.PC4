<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LTC2.Desktopclients.AvaloniaClient.Windows.UpdateWindow"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Width="850"
        Height="440"
        Background="#E6E8EA">

    <StackPanel>
        <Border HorizontalAlignment="Center" Background="#E6E8EA" Margin="20" Width="810" Height="100" Theme="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblLabelStatusUpdate" Grid.Row="0" Grid.Column="0"/>
                <TextBlock x:Name="LblStatusUpdate" Grid.Row="0" Grid.Column="1"/>
                <TextBlock x:Name="LblLabelProgressUpdate" Grid.Row="1" Grid.Column="0"/>
                <TextBlock x:Name="LblProgressUpdate" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border HorizontalAlignment="Center" x:Name="BdrBottom" Margin="20,10" Width="810" Height="260" Background="#E6E8EA" Theme="{StaticResource CardBorder}">
            <StackPanel Orientation="Vertical">
                <RadioButton x:Name="RdoNormal" GroupName="UpdateGroup" Margin="10,10,0,0" IsChecked="True" Click="ClickHandlerRdoNormal"/>
                <RadioButton x:Name="RdoFull" GroupName="UpdateGroup" Margin="10,10,0,0" Click="ClickHandlerRdoFull"/>
                <CheckBox x:Name="ChkReload" IsEnabled="False" Margin="50,10,0,0"/>
                <Button x:Name="BtnStartUpdate" Margin="0,30,0,0" Width="700" Height="80" IsEnabled="True" Theme="{StaticResource LightButton}" Background="#C6CACD" Classes="Tertiary" Click="ClickHandlerStartUpdate"/>
                <Button x:Name="BtnSelectMultiSports" IsVisible="False" Margin="0,20,0,0" Width="280" Height="40" IsEnabled="True" Theme="{StaticResource LightButton}" Background="#C6CACD" Classes="Tertiary" Click="ClickHandlerSelectMultiSports"/>
            </StackPanel>
        </Border>
    </StackPanel>

</Window>
