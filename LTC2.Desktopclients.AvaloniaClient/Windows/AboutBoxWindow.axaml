<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LTC2.Desktopclients.AvaloniaClient.Windows.AboutBoxWindow"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Width="400"
        Height="250"
        Background="LightGray">

    <StackPanel Orientation="Vertical" Margin="20">

        <Border HorizontalAlignment="Center" Width="360" Margin="0,0,0,15" Theme="{StaticResource CardBorder}">
            <StackPanel Orientation="Vertical" Margin="15">
                <TextBlock x:Name="LblAppName" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" HorizontalAlignment="Center" />
                <TextBlock x:Name="LblVersion" HorizontalAlignment="Center" Margin="0,0,0,5" />
                <TextBlock x:Name="LblCopyright" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Button x:Name="BtnClose" Width="100" Height="35" Classes="Tertiary" Theme="{StaticResource SolidButton}" Click="ClickHandlerClose" HorizontalAlignment="Center" />

    </StackPanel>

</Window>
