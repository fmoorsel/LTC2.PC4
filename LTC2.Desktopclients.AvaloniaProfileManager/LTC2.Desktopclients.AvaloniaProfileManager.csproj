<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
	<Nullable>disable</Nullable>
	<ImplicitUsings>disable</ImplicitUsings>
	<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Resources\Long Term Challenge Logo3.ico</ApplicationIcon>
	<Version>1.0.0</Version>
	<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">WINDOWS</DefineConstants>
	<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Avalonia" Version="12.0.5" />
	<PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
	<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
	<PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
	<PackageReference Include="Deadpikle.AvaloniaProgressRing" Version="0.11.0" />
	<PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
	<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	<PackageReference Include="Semi.Avalonia" Version="12.0.3" />
	<PackageReference Include="Serilog" Version="4.3.1" />
	<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
	<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
	<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
	<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\LTC2.Shared.BaseMessages\LTC2.Shared.BaseMessages.csproj" />
	<ProjectReference Include="..\LTC2.Shared.Models\LTC2.Shared.Models.csproj" />
	<ProjectReference Include="..\LTC2.Shared.Repositories\LTC2.Shared.Repositories.csproj" />
	<ProjectReference Include="..\LTC2.Shared.Secrets\LTC2.Shared.Secrets.csproj" />
	<ProjectReference Include="..\LTC2.Shared.Utils\LTC2.Shared.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="Resources\Long Term Challenge Logo3.ico" />
  </ItemGroup>

  <ItemGroup>
	<None Update="appsettings.Development.json">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
	<None Update="appsettings.json">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
	<None Update="Resources\messages.nl.json">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
	<None Update="serilogsettings.json">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>
</Project>
