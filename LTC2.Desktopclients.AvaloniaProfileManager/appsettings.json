{
  "AppSettings": {
    "Name": "Profile manager",
    "StartPage": "http://localhost:50003",
    "MonitoredComponent": "webapp",
    "PingDeltaInSeconds": 10,

    "WebApp": "%HOME%/LTC2Apps/MainApp/LTC2.Webapps.MainApp",
    "WebAppParameters": "pipe:profapp urls:http://localhost:50003",
    "WebAppNoWindow": true,
    "WebAppWindowMinimized": false,

    "WebviewRoot": "%HOME%/LTC2/PC4/Misc/Webview",
    "DisablePasswordSave": false,

    "LibraryPath": "/usr/lib/x86_64-linux-gnu/"
  },
  "GenericSettings": {
    "Id": "PC4",
    "Name": "Postcode-gebieden in Nederland",
    "SecretsFolder": "%LOCALAPPDATA%/LTC2/PC4/Secrets"
  }
}
